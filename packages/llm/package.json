{
  "name": "@obidot-kit/llm",
  "version": "0.2.0",
  "description": "LangChain tool implementations and agent factory for Obidot Kit",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@obidot-kit/core": "workspace:*",
    "@polkadot-agent-kit/common": "2.1.5",
    "@polkadot-agent-kit/llm": "2.1.5",
    "polkadot-api": "^1.23.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  },
  "keywords": [
    "polkadot",
    "agent",
    "langchain",
    "llm",
    "defi",
    "xcm"
  ],
  "homepage": "https://github.com/obidot/obi-kit#readme",
  "bugs": {
    "url": "https://github.com/obidot/obi-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obidot/obi-kit.git",
    "directory": "packages/llm"
  },
  "publishConfig": {
    "access": "public"
  }
}
