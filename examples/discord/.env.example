# ── Discord Bot ───────────────────────────────────────────────────────────
# Bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=
# Application Client ID (for registering slash commands)
DISCORD_CLIENT_ID=

# ── LLM Configuration ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional: override the default model (gpt-4o-mini)
# OPENAI_MODEL=gpt-4o

# ── Vault Configuration (optional) ──────────────────────────────────────
# When PRIVATE_KEY is set the bot runs in EVM mode (real transactions).
# Without it the bot runs in offline/stub mode (safe for testing).
# HUB_RPC_URL=https://westend-asset-hub-eth-rpc.polkadot.io
# VAULT_ADDRESS=0x0000000000000000000000000000000000000001
# ASSET_ADDRESS=0x0000000000000000000000000000000000000002
# PRIVATE_KEY=0x...
