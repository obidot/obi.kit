# Arbitrage bot template - preview mode by default.

# Polkadot Hub Paseo TestNet
HUB_RPC_URL=https://eth-rpc-testnet.polkadot.io/
SWAP_ROUTER_ADDRESS=0x60a72d1e20c5dc40Bb5a24394f0583d863201A3c

# Scan profile
RUN_LABEL=uv2-spread-monitor
AMOUNT_IN=1000000000000000000
THRESHOLD_BPS=50
MAX_OPPORTUNITIES=3

# Limit the scan to a subset of known pairs when needed.
# PAIRS=tDOT/tUSDC,tDOT/tETH,tUSDC/tETH

# Safe by default. Toggle on only after reviewing the detected route.
EXECUTE_SWAPS=false

# Required only for execution mode
# PRIVATE_KEY=0x...
