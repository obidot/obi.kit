# ── LLM Configuration ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional: override the default model (gpt-4o-mini)
# OPENAI_MODEL=gpt-4o

# ── Vault Configuration ─────────────────────────────────────────────────────
# When PRIVATE_KEY is set the agent runs in EVM mode (real transactions).
# Without it the agent runs in offline/stub mode (safe for testing).

# Polkadot Hub Paseo TestNet — chain 420420417
HUB_RPC_URL=https://eth-rpc-testnet.polkadot.io/

# ObidotVault v3 (ERC-4626 hub vault)
VAULT_ADDRESS=0x03473a95971Ba0496786a615e21b1e87bDFf0025

# TestDOT ERC-20 asset
ASSET_ADDRESS=0x2402C804aD8a6217BF73D8483dA7564065c56083

# ── DEX Aggregator (optional) ───────────────────────────────────────────────
# SWAP_ROUTER_ADDRESS=0x0A85A1B0bb893cab3b5fad7312ac241e92C8Badf
# SWAP_QUOTER_ADDRESS=0x81d7aCFEF474DA6c76eC1b5A05a137cB9f3A5Db1

# ── Oracle (optional) ────────────────────────────────────────────────────────
# ORACLE_REGISTRY_ADDRESS=0x8b7C7345d6cF9de45f4aacC61F56F0241d47e88B

# ── Signing Key ─────────────────────────────────────────────────────────────
# Your signing key (hex, 0x-prefixed) — required for EVM mode
# PRIVATE_KEY=0x...
