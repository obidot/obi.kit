# ── Hub Chain Configuration ──────────────────────────────────────────────
# WebSocket RPC endpoint for the Polkadot relay chain
RPC_ENDPOINT=wss://rpc.polkadot.io

# Hub vault contract address (EVM-compatible, deployed on Moonbeam or similar)
HUB_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# CrossChainRouter contract address
ROUTER_ADDRESS=0x0000000000000000000000000000000000000000

# BifrostAdapter contract address
BIFROST_ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000

# Hub chain JSON-RPC URL (EVM side, e.g. Moonbeam)
HUB_RPC_URL=https://rpc.api.moonbeam.network

# ── Satellite Chain: Moonbeam ────────────────────────────────────────────
MOONBEAM_RPC_URL=https://rpc.api.moonbeam.network
MOONBEAM_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
MOONBEAM_CHAIN_ID=1284

# ── Satellite Chain: Astar ───────────────────────────────────────────────
ASTAR_RPC_URL=https://evm.astar.network
ASTAR_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
ASTAR_CHAIN_ID=592

# ── LLM Configuration (optional, for LLM-driven mode) ───────────────────
# OPENAI_API_KEY=sk-...
